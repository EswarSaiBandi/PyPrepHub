# Public site URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://pyprephub.com

# Site identity
NEXT_PUBLIC_SITE_NAME=PyPrepHub
NEXT_PUBLIC_SITE_DESCRIPTION="Python, Data Science, ML, SQL & AI interview preparation."

# Google AdSense publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT=

# Giscus comments (create config at https://giscus.app)
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=General
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Google Analytics / Search Console
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# Newsletter provider (Buttondown / ConvertKit / Mailchimp)
NEWSLETTER_PROVIDER=buttondown
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=
